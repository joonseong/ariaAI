{
  "expo": {
    "name": "Aria",
    "slug": "aria",
    "version": "1.0.0",
    "scheme": "aria",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.minimal.aria2",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "appleTeamId": "QB5LWB6R86",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "작품 이미지를 선택하기 위해 사진 접근 권한이 필요합니다."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1082441690200-cjt36idav5cbmgb1i0e438rdl4oq3fdo"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "2f6211743e4b1607294adc9b735e141f"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2b20db6-a1d1-4fb2-af39-5944604cebb9"
      }
    },
    "owner": "joonsays-organization"
  }
}
